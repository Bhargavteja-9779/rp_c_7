\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The reduced-basis group wins clearly on smooth problems at large budgets, and most differences at small budgets are ties. (a) Number of the 24{} main problems (own solvers; five methods; three seeds; tie band $\pm 0.1$ decade) in which the reduced-basis group is clearly better, tied, or clearly worse than the direct networks, by training budget. (b) Median signed effect $\bar  y$ by problem class over all 44{} problems (number of problems in brackets; $\dagger $: solved with \texttt  {scikit-fem}); the colour scale is centred at zero and blue is the same colour as in (a). Per-problem values are in Supplement Table~\ref {tab:S-perproblem}. The $N=1024$ results are confounded with a doubling of the networks' optimiser steps (Supplement Sec.~\ref {sec:S-earlier}).}}{13}{figure.2}\protected@file@percent }
\newlabel{fig:main}{{2}{13}{The reduced-basis group wins clearly on smooth problems at large budgets, and most differences at small budgets are ties. (a) Number of the \NMainProblems {} main problems (own solvers; five methods; three seeds; tie band $\pm 0.1$ decade) in which the reduced-basis group is clearly better, tied, or clearly worse than the direct networks, by training budget. (b) Median signed effect $\bar y$ by problem class over all \NAllProblems {} problems (number of problems in brackets; $\dagger $: solved with \texttt {scikit-fem}); the colour scale is centred at zero and blue is the same colour as in (a). Per-problem values are in Supplement Table~\ref {tab:S-perproblem}. The $N=1024$ results are confounded with a doubling of the networks' optimiser steps (Supplement Sec.~\ref {sec:S-earlier})}{figure.2}{}}
\newlabel{fig:main@cref}{{[figure][2][]2}{[1][12][]13}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Why the Gaussian-process reduced model wins when it does}{13}{subsection.6.2}\protected@file@percent }
\newlabel{sec:results-mech}{{6.2}{13}{Why the Gaussian-process reduced model wins when it does}{subsection.6.2}{}}
\newlabel{sec:results-mech@cref}{{[subsection][2][6]6.2}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Widening the hyper-parameter search of kernel ridge closes most of the gap to the Gaussian-process reduced model, and a Gaussian process on the full field is as good as the POD-based one. Error ratio of each alternative to the reduced-basis Gaussian process in the 28{} budget--problem combinations where that model clearly beats the best network (own-solver problems, budgets 64, 256, 1024); boxes show quartiles, dots individual combinations, the dashed line a factor of three.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:mech}{{3}{14}{Widening the hyper-parameter search of kernel ridge closes most of the gap to the Gaussian-process reduced model, and a Gaussian process on the full field is as good as the POD-based one. Error ratio of each alternative to the reduced-basis Gaussian process in the \KrrNarrowN {} budget--problem combinations where that model clearly beats the best network (own-solver problems, budgets 64, 256, 1024); boxes show quartiles, dots individual combinations, the dashed line a factor of three}{figure.3}{}}
\newlabel{fig:mech@cref}{{[figure][3][]3}{[1][12][]14}}
