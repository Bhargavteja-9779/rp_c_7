\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The reduced-basis group wins clearly on smooth problems at large budgets, and most differences at small budgets are ties. (a) Number of the 24{} main problems (own solvers; five methods; three seeds; tie band $\pm 0.1$ decade) in which the reduced-basis group is clearly better, tied, or clearly worse than the direct networks, by training budget. (b) Median signed effect $\bar  y$ by problem class over all 44{} problems (number of problems in brackets; $\dagger $: solved with \texttt  {scikit-fem}); the colour scale is centred at zero and blue is the same colour as in (a). Per-problem values are in Supplement Table~\ref {tab:S-perproblem}. The $N=1024$ results are confounded with a doubling of the networks' optimiser steps (Supplement Sec.~\ref {sec:S-earlier}).}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:main}{{2}{15}{The reduced-basis group wins clearly on smooth problems at large budgets, and most differences at small budgets are ties. (a) Number of the \NMainProblems {} main problems (own solvers; five methods; three seeds; tie band $\pm 0.1$ decade) in which the reduced-basis group is clearly better, tied, or clearly worse than the direct networks, by training budget. (b) Median signed effect $\bar y$ by problem class over all \NAllProblems {} problems (number of problems in brackets; $\dagger $: solved with \texttt {scikit-fem}); the colour scale is centred at zero and blue is the same colour as in (a). Per-problem values are in Supplement Table~\ref {tab:S-perproblem}. The $N=1024$ results are confounded with a doubling of the networks' optimiser steps (Supplement Sec.~\ref {sec:S-earlier})}{figure.2}{}}
\newlabel{fig:main@cref}{{[figure][2][]2}{[1][13][]15}}
